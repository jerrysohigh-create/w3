PORT=4184
HOST=127.0.0.1
W3_REFRESH_SECONDS=60
W3_STALE_AFTER_SECONDS=300
W3_CHAIN_SYNC_SECONDS=300
# Production: mount this directory on persistent storage. When unset, the
# repository snapshots remain the local development fallback.
W3_DATA_DIR=
PAYMENT_API_BASE=https://payment.magne.ai/api
BSC_RPC_URLS=https://bsc-dataseed.bnbchain.org,https://rpc-bsc.48.club

# Production: inject a dedicated zero-asset wallet private key from your
# server secret manager. Never commit it and never expose it to the browser.
W3_SERVICE_WALLET_PRIVATE_KEY=

# Development only. Creates a new zero-asset wallet in memory at each start.
# The private key is never logged or written to disk.
W3_ALLOW_EPHEMERAL_WALLET=false
