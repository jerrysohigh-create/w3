# W3.MAGNE.AI production service environment
NODE_ENV=production
PORT=4184
HOST=127.0.0.1

W3_REFRESH_SECONDS=60
W3_STALE_AFTER_SECONDS=300
W3_CHAIN_SYNC_SECONDS=300
W3_DATA_DIR=/var/lib/w3

PAYMENT_API_BASE=https://payment.magne.ai/api
BSC_RPC_URLS=https://bsc-dataseed.bnbchain.org,https://rpc-bsc.48.club

# BSC history sync is independent of Payment wallet authentication. Use one or
# more RPC endpoints that support eth_getLogs; comma-separate multiple URLs.
# Leave empty to use the bundled public fallbacks.
BSC_HISTORY_RPCS=
S2_HISTORY_WINDOW=25
S2_HISTORY_MAX_WINDOWS=200
S2_HISTORY_CONCURRENCY=1
S2_HISTORY_OVERLAP=100
S2_HISTORY_CONFIRMATIONS=15
S2_HISTORY_FULL=false

# Inject this value from the server secret manager or protected environment file.
# Never commit the real key.
W3_SERVICE_WALLET_PRIVATE_KEY=
W3_ALLOW_EPHEMERAL_WALLET=false
