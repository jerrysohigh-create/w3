[Unit]
Description=W3.MAGNE.AI realtime site and Season 2 collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=w3
Group=w3
WorkingDirectory=/opt/w3
EnvironmentFile=/etc/w3/w3.env
ExecStart=/usr/bin/node /opt/w3/server/index.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/w3

[Install]
WantedBy=multi-user.target
